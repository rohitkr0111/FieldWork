{
  "name": "enterprise-website-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "npm run db:generate -w @showcase/database",
    "db:migrate": "npm run db:migrate -w @showcase/database",
    "db:deploy": "npm run db:deploy -w @showcase/database",
    "db:seed": "npm run db:seed -w @showcase/database"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "eslint": "^9.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "postcss": "^8.5.24"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
